# ═══════════════════════════════════════════════════════════════════════════
# Copy to `.env` and fill in. Everything here is optional — the app runs with
# no keys at all, falling back to the deterministic stub planner and local
# SQLite. Each key unlocks a specific capability rather than being required.
# ═══════════════════════════════════════════════════════════════════════════

# ── Role cookie signing ──
# Without this a random key is generated at startup and role cookies are
# invalidated on every restart.
CONCA_SECRET=

# ── Remote role ──
# What a caller from another machine gets when they present no cookie. Blank means
# `public`, which is the safe default and the right one for almost everyone.
#
# There is no PIN and no password anywhere in this app. A caller on the loopback
# interface is granted `staff` outright, on the reasoning that whoever is sitting
# at this machine already owns this file, `.conca` and the database — they can
# grant themselves anything with a text editor, so a secret asked of them buys
# nothing. Anyone else gets the value below and cannot escalate: /api/auth/login
# and the setup routes are refused off-loopback regardless of what is set here.
#
# Set it to `staff` only to let the phone wrapper reach the operations surface,
# and only on a network you trust — it applies to every host that can route to
# this port, not just to your phone.
CONCA_OPEN_ROLE=

# ── Model rotator ──
# The ladder is walked top-down; any key you supply is used, any you omit is
# skipped. GEMINI_API_KEY alone is enough for a good demo. The _2 / _3 slots are
# separate Gemini projects, which is how the original survived free-tier RPM
# limits — three independent quotas for the same model.
#
# GEMINI_API_KEY is also the only key that unlocks screen reading: the vision
# path (`complete_vision`) runs on Gemini's inline-image support, and with no
# Gemini key a capture reports that the screen was not read rather than guessing.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=

# ── Model rotator, unverified tier ──
# Seven more providers, all reached through the same OpenAI-compatible adapter.
# They sit at the bottom of the ladder because their base URLs and model ids were
# written from documentation rather than from a call that succeeded — a wrong id
# costs one attempt and a rotate, and placing them last means that cost is only
# ever paid after everything known-good has retired. Promote an entry in
# rotator.py once you have watched it answer.
#
# OPENROUTER_API_KEY is the highest-leverage one by a distance: a single key
# reaches 100+ models, and the `openrouter/auto` row cannot break when a model
# name changes because OpenRouter does the choosing.
#
# ANTHROPIC_API_KEY is deliberately the last live row on the ladder — it is the
# only entry with no free allowance at all, so it should be reached only when
# every free tier above it is exhausted.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
PERPLEXITY_API_KEY=
HUGGINGFACE_API_KEY=
ANTHROPIC_API_KEY=

# ── Research agent ──
# Tavily gives clean, citable results. Without it, search falls back to a
# keyless DuckDuckGo HTML scrape, which works but is brittle.
TAVILY_API_KEY=

# ── Email + Calendar (Google) ──
# Needs all three. Without them the Email Hub reports "not connected" and the
# Calendar runs entirely on local SQLite.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Telecom (Twilio) ──
# Texting needs the SID + token plus ONE sender: a Messaging Service SID is
# preferred and is what the console hands you first, since it survives adding or
# renumbering senders without a redeploy. Voice has no equivalent, so placing
# calls needs a real TWILIO_PHONE_NUMBER even when texting goes out through an
# MG SID.
#
# Inbound additionally needs a public tunnel pointed at POST /api/sms/webhook —
# without one, sends work and receives simply do not arrive.
#
# A new account also needs carrier registration (KYC / A2P 10DLC) and the
# destination country enabled under Messaging → Geo Permissions and Voice →
# Dialing Permissions. Until those clear, Twilio rejects the request and the
# telecom tools report the code and the setting to change — see _TWILIO_CODES in
# tools.py.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ── GitHub Intelligence ──
# Optional even for GitHub itself: public repositories work with no token at 60
# requests/hour, shared across the whole machine by IP. A classic or fine-grained
# token with read-only `public_repo` scope raises that to 5000/hour and is the
# only way to read a private repo. The tool has no write path at all, so a token
# with any write scope grants more than this app can use.
GITHUB_TOKEN=

# ── Social publishing (Mastodon) ──
# Mastodon is the only platform wired for real sends, because it is the only one
# whose API needs nothing but a bearer token. Without the token, and for X and
# LinkedIn regardless, `social_post` stores a draft and reports published=False
# rather than silently discarding the attempt.
# BASE_URL defaults to https://mastodon.social; set it to your own instance.
MASTODON_ACCESS_TOKEN=
MASTODON_BASE_URL=

# ── Misc ──
# Interpreter used for the sandboxed python_execute tool.
PYTHON_EXE=python

# Set to 1/true/yes to skip starting the cron thread on boot. The schedules in
# .conca stay parsed and visible in the UI; nothing fires. Useful when running
# the suite or a demo where an unattended job would confuse the trace.
CONCA_DISABLE_SCHEDULER=
