{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Concaretti",
  "version": "0.1.0",
  "identifier": "app.concaretti.light",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -C ../frontend dev",
    "beforeBuildCommand": "pnpm -C ../frontend build --mode desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Concaretti",
        "width": 1320,
        "height": 880,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "theme": "Light",
        "backgroundColor": "#FFFBF0"
      },
      {
        "label": "overlay",
        "title": "Concaretti overlay",
        "url": "index.html#overlay",
        "width": 620,
        "height": 460,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "center": true
      },
      {
        "label": "hud",
        "title": "Thought HUD",
        "url": "index.html#hud",
        "width": 800,
        "height": 200,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "y": 100
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' http://127.0.0.1:8000 http://localhost:8000",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/concaretti-backend"],
    "resources": []
  }
}
